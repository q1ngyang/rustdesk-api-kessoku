# Ignore Docker Compose configuration files
docker-compose.yaml
docker-compose-dev.yaml

# Ignore development Dockerfile
Dockerfile
Dockerfile.dev
docker-dev.sh

# Ignore the data directory
data/

# Ignore version control system directories
.git/

# Ignore log and temporary files
*.log
*.tmp
*.swp

# Ignore editor/IDE configuration files
.vscode/
.idea/

# Ignore binaries and build cache
release/
bin/
*.exe
*.out

# Historical browser-client assets must never enter an image build context.
resources/web/
resources/web2/

# Embedded admin-web source is a reviewed build input; only local derivatives
# are excluded from the source-build context.
admin-web/node_modules/
admin-web/dist/
admin-web/candidate/

# The repository-owned web client is a reviewed source input; only local
# derivatives are excluded. Its production dist is rebuilt in the image.
web-client/node_modules/
web-client/dist/

# Local integration runtime data contains generated keys, databases, and
# client profiles. It must never enter a source-build context.
deploy-local-test/state/
deploy-local-test/.env

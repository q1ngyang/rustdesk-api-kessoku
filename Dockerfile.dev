FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS builder-backend

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod verify && \
    go install github.com/swaggo/swag/cmd/swag@v1.16.6 && \
    swag init -g cmd/apimain.go --output docs/api --instanceName api --exclude http/controller/admin && \
    swag init -g cmd/apimain.go --output docs/admin --instanceName admin --exclude http/controller/api

# This development-only source build intentionally receives no .git directory
# through .dockerignore. Published images consume the separately verified
# candidate binary, whose exact revision and clean-tree state are recorded.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build -trimpath -buildvcs=false \
    -ldflags "-s -w" -o /out/kessoku-api ./cmd

FROM node:24.15.0-bookworm@sha256:f22d6a1f082c02f292e86929b5b0442ac2e5eaf438a5dea9b1566601c3e05940 AS builder-admin-frontend

WORKDIR /src/admin-web
COPY admin-web/package.json admin-web/package-lock.json admin-web/.npmrc ./
RUN --mount=type=cache,target=/root/.npm \
    test "$(npm --version)" = "11.12.1" && \
    npm ci

# The reviewed UI source is part of the same Kessoku commit. No repository,
# branch, URL, or alternate path can be supplied as a build argument.
COPY admin-web/ ./
COPY .github/workflows/build.yml /src/.github/workflows/build.yml
RUN --mount=type=cache,target=/root/.npm \
    npm audit --omit=dev --audit-level=high && \
    npm run lint --if-present && \
    npm test --if-present && \
    npm run build

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

WORKDIR /app
COPY --from=builder-backend /out/kessoku-api /app/kessoku-api
COPY --from=builder-backend /src/conf /app/conf/
COPY --from=builder-backend /src/resources/i18n /app/resources/i18n/
COPY --from=builder-backend /src/resources/public /app/resources/public/
COPY --from=builder-backend /src/resources/templates /app/resources/templates/
COPY --from=builder-backend /src/resources/version /app/resources/version
COPY --from=builder-backend /src/docs /app/docs/
COPY --from=builder-backend /src/LICENSE /app/LICENSE
COPY --from=builder-admin-frontend /src/admin-web/dist/ /app/resources/admin/
COPY --from=builder-admin-frontend /src/admin-web/LICENSE /app/ADMIN-WEB-LICENSE

RUN mkdir -p /app/data /app/runtime && \
    chown -R 65534:65534 /app/data /app/runtime

USER 65534:65534
VOLUME /app/data
EXPOSE 21114 21121
CMD ["./kessoku-api"]

# Use the immutable release tag first. After pulling, record and deploy the
# resolved digest according to your change-control policy.
KESSOKU_IMAGE=ghcr.io/q1ngyang/rustdesk-api-kessoku:v3.0.4

TZ=Asia/Shanghai
KESSOKU_LANG=zh-CN
# Keep the application port host-local and publish HTTPS through the reviewed
# reverse proxy. Change this only when a separately restricted network path
# requires it.
KESSOKU_BIND_ADDRESS=127.0.0.1
KESSOKU_API_PORT=21114
KESSOKU_CLIENT_BIND_ADDRESS=127.0.0.1
KESSOKU_CLIENT_PORT=21122
KESSOKU_PUBLIC_URL=https://api.example.com
KESSOKU_TRUST_PROXY=
# Copy examples/config.docker-builtin.yaml to this path and edit the exact
# client/API origins, WSS endpoints, Relay-name map, generation, and key.
KESSOKU_CONFIG_FILE=./config.yaml

# Nginx examples for the two host-local listeners are under examples/nginx/.

RUSTDESK_ID_SERVER=rustdesk.example.com:21116
RUSTDESK_RELAY_SERVER=rustdesk.example.com:21117
# This is the public RustDesk server key, not a private key.
RUSTDESK_SERVER_PUBLIC_KEY=replace-with-id_ed25519.pub

KESSOKU_DATA_DIR=./data/kessoku
KESSOKU_SECRETS_DIR=./secrets

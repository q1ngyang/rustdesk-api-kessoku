# Relay-only HBBR node. Copy this file to .env and keep .env out of Git.

RELAY_COMPOSE_PROJECT_NAME=rustdesk-relay
RELAY_HBBR_CONTAINER_NAME=rustdesk-relay-hbbr
RELAY_RESTART_POLICY=unless-stopped
RELAY_DATA_DIR=./data
RUSTDESK_LOG_LEVEL=info

# Recommended: use the HBBR bundled with the exact Starry version used by the
# centre HBBS. These two active lines match the active image line in compose.yaml.
STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry
STARRY_VERSION=1.1.16-patch-v1.2.2

# Official alternative. To use it, uncomment this line, comment the two Starry
# lines above, and switch the two image lines in compose.yaml as instructed.
# OFFICIAL_HBBR_IMAGE=rustdesk/rustdesk-server:1.1.16

# Paste the complete one-line content of the centre HBBS id_ed25519.pub file.
# This is a public key. Never copy or paste the private id_ed25519 file here.
RUSTDESK_PUBLIC_KEY=REPLACE_WITH_CENTRE_ID_ED25519_PUBLIC_KEY

# HBBR limits. Bandwidth/speed values are Mb/s, the start check is seconds,
# and the threshold is a fraction of the per-session limit.
RELAY_SINGLE_BANDWIDTH=128
RELAY_TOTAL_BANDWIDTH=1024
RELAY_LIMIT_SPEED=32
RELAY_DOWNGRADE_START_CHECK=1800
RELAY_DOWNGRADE_THRESHOLD=0.66

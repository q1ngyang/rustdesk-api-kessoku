# Kessoku + Starry single-host deployment.
# Copy this file to .env, replace every REPLACE_* value, and keep .env out of Git.

COMPOSE_PROJECT_NAME=rustdesk-kessoku-starry
TZ=Asia/Shanghai

# Pin production deployments to an explicit release, not latest.
KESSOKU_IMAGE=ghcr.io/q1ngyang/rustdesk-api-kessoku:v3.0.1
STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry
STARRY_VERSION=1.1.16-patch-v1.2.0

# Three DNS names may point to the same public IPv4 address.
RUSTDESK_DOMAIN=rustdesk.example.com
KESSOKU_PUBLIC_URL=https://api.example.com

# Paste the complete one-line content of data/starry/id_ed25519.pub after the
# first HBBS start. This is a public key, never data/starry/id_ed25519.
RUSTDESK_SERVER_PUBLIC_KEY=REPLACE_AFTER_FIRST_HBBS_START

# Kessoku listeners remain host-local; Nginx is the only public HTTP entry.
KESSOKU_BIND_ADDRESS=127.0.0.1
KESSOKU_API_PORT=21114
KESSOKU_CLIENT_BIND_ADDRESS=127.0.0.1
KESSOKU_CLIENT_PORT=21122
KESSOKU_LANG=zh-CN
# Leave empty initially. If real client IP logging is required, set only the
# exact Docker bridge gateway observed for this container, never 0.0.0.0/0.
KESSOKU_TRUST_PROXY=

# Use absolute paths in long-lived deployments.
KESSOKU_CONFIG_FILE=./kessoku-config.yaml
KESSOKU_DATA_DIR=./data/kessoku
KESSOKU_SECRETS_DIR=./secrets/kessoku
STARRY_CONFIG_FILE=./starry-config.yaml
STARRY_DATA_DIR=./data/starry

RUSTDESK_LOG_LEVEL=info
STARRY_RESTART_POLICY=unless-stopped
